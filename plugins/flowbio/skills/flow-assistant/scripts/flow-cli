#!/bin/sh
# Runs the flowbio CLI at the version this skill is written against. The pin
# lives here alone; the skill's instructions call flow-cli, never a version.
FLOWBIO_VERSION=0.14.1

# The skill pre-approves `api get`, so no argument may send the request, and the
# saved token with it, to another host or swap in another credential. flowbio
# accepts any unambiguous abbreviation, hence the prefix match.
refused=
for arg in "$@"; do
  option=${arg%%=*}
  case $option in --?*) ;; *) continue ;; esac
  case --base-url in "$option"*) refused=$option ;; esac
  case --token-file in "$option"*) refused=$option ;; esac
  if [ -n "$refused" ]; then
    echo "flow-cli: $refused is not accepted. Set FLOW_API_URL to use another Flow instance; the token comes from ~/.config/flow/api-token." >&2
    exit 2
  fi
done

if command -v uvx >/dev/null 2>&1; then
  exec uvx --from "flowbio==$FLOWBIO_VERSION" flowbio "$@"
elif command -v pipx >/dev/null 2>&1; then
  exec pipx run --spec "flowbio==$FLOWBIO_VERSION" flowbio "$@"
elif command -v flowbio >/dev/null 2>&1; then
  if installed=$(flowbio --version 2>/dev/null); then
    [ "$installed" = "flowbio $FLOWBIO_VERSION" ] && exec flowbio "$@"
    found="The flowbio on your PATH reports \"$installed\", not $FLOWBIO_VERSION."
  else
    found="The flowbio on your PATH doesn't run (flowbio --version failed)."
  fi
else
  found="I couldn't find uv (or pipx, or flowbio) on your PATH."
fi

cat >&2 <<MESSAGE
Using Flow needs the flowbio CLI, which this skill runs on demand via uv.
$found Install one of:
  • uv   — https://docs.astral.sh/uv/ (recommended); or
  • pipx — pip install --user pipx; or
  • flowbio directly — pip install "flowbio==$FLOWBIO_VERSION".
Then ask me again.
MESSAGE
exit 127
